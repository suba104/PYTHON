import time 
import sys
h=9
m=15
s=0
while True:
    sys.stdout.write( "\r{}:{}:{}" .format(h,m,s))
    sys.stdout.flush()
    time.sleep(1)
    s=s+1
    
    if s==60:
        s=0
        m=m+1
    if m==60:
        s=0
        m=0
        h=h+1
    if h==24:
        s=0
        m=0
        h=0
        
