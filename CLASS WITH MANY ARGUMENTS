class AIML:
    def set_dim(self,a,b,c,d):
        self.m1=a 
        self.m2=b 
        self.m3=c 
        self.name=d 
    def display(self):
        print("1.name:",self.name)
        print("2.marks %:",(self.m1+self.m2+self.m3)//3)
S1=AIML()
S2=AIML()
S1.set_dim(20,30,40,"sarathy")
S2.set_dim(30,40,50,"ajay")
S1.display()
S2.display()
